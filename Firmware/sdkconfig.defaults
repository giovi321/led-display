CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB QIO @ 80 MHz (N16R8 module)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: 8 MB Octal (N16R8 module ships with OPI PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Custom partition table (two OTA slots, see partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: keep the new image tentative until the app marks itself valid, so a
# broken update rolls back on the next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA-from-URL may point at a plain-HTTP host on the LAN (n8n, CI artifact
# server). TLS still works when the URL is https://.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# HTTP server: enough room for the embedded web UI
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=512

# lwIP: a few extra sockets for the captive portal + REST clients
CONFIG_LWIP_MAX_SOCKETS=10

# lwIP tcpip task stack. The WireGuard client marshals every component call
# into this thread (esp_netif_tcpip_exec) and the component's own sys_timeout
# rekey timer runs there too, so psa_crypto_init() plus the x25519/blake2s
# handshake crypto all execute on this stack rather than the caller's. The
# 3072-byte IDF default is not enough headroom for that; measured free space
# at the deepest point is reported as wireguard.tcpip_stack_free_min.
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=8192

# REQUIRED by the WireGuard client, and the reason a tunnel used to panic the
# device the moment it was enabled.
#
# esp_netif normally stores its own handle in the lwIP netif's `state` field
# and its global netif callback casts `state` back to an esp_netif_t
# unconditionally. WireGuard adds a raw lwIP netif whose `state` is the
# component's own device struct, so that cast produced a wild pointer and the
# first address event during netif_add dereferenced it: an instant
# LoadProhibited panic, before a single line of WireGuard's own init ran.
#
# IDF's own lwipopts.h spells the rule out - interfaces that use `state`
# themselves (it names bridge and ppp) need the esp_netif pointer kept in
# lwIP client data instead - but it only switches that on for bridge or PPP
# builds. Enabling the bridge is the cheapest way to set LWIP_ESP_NETIF_DATA,
# which moves the pointer and makes the callback resolve to NULL (and return)
# for netifs esp_netif did not create.
CONFIG_ESP_NETIF_BRIDGE_EN=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1

# Main task stack a bit larger to comfortably hold the boot sequence
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Logging defaults to INFO
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# WireGuard client compiled in (runtime-disabled until configured). Pinned
# here because a persisted sdkconfig from a build where the port was broken
# would otherwise keep it off forever.
CONFIG_LEDDISP_WIREGUARD=y
